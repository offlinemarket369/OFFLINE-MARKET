---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Register Your Business — OFFLINE MARKET</title>
</head>
<body class="bg-gray-50 text-gray-900">

  <header class="bg-blue-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-50 shadow">
    <a href="/" class="flex items-center gap-2">
      <span class="text-2xl">🏪</span>
      <span class="font-bold text-lg">OFFLINE MARKET</span>
    </a>
    <a href="/" class="text-sm text-blue-200">← Back</a>
  </header>

  <main class="px-4 py-6 max-w-2xl mx-auto">
    <h1 class="text-2xl font-bold mb-1">Register Your Business</h1>
    <p class="text-gray-500 text-sm mb-6">अपनी दुकान रजिस्टर करें — Admin approval के बाद live होगी</p>

    <form id="businessForm" class="space-y-5 bg-white p-5 rounded-xl shadow-sm border border-gray-100">

      <div>
        <label class="block text-sm font-semibold mb-1">Shop Name / दुकान का नाम *</label>
        <input type="text" name="shop_name" required
          placeholder="e.g. Sharma Mobile Shop"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Owner Name / मालिक का नाम *</label>
        <input type="text" name="owner_name" required
          placeholder="e.g. Rajesh Sharma"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Contact Number / फ़ोन नंबर *</label>
        <input type="tel" name="phone" required pattern="[0-9]{10}"
          placeholder="10-digit mobile number"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">WhatsApp Number (optional)</label>
        <input type="tel" name="whatsapp"
          placeholder="Same as contact if empty"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500" />
      </div>
           <div>
        <label class="block text-sm font-semibold mb-1">Face Photos (2) / चेहरे की फोटो</label>
        <input type="file" name="face_photo" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 mb-2" />
        <input type="file" name="face_photo_2" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50" />
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Shop Photos (3) / दुकान की फोटो</label>
        <input type="file" name="shop_photo" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 mb-2" />
        <input type="file" name="shop_photo_2" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50 mb-2" />
        <input type="file" name="shop_photo_3" accept="image/*" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm bg-gray-50" />
      </div>
      <div>
        <label class="block text-sm font-semibold mb-1">Category / श्रेणी *</label>
        <select name="category" id="category" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500">
          <option value="">-- Select Category --</option>
          <option value="Services">Services / सेवाएँ</option>
          <option value="Retail">Retail / खुदरा</option>
          <option value="Education">Education / शिक्षा</option>
          <option value="Food">Food / खाना</option>
          <option value="Other">Other / अन्य</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Subcategory / उप-श्रेणी *</label>
        <select name="subcategory" id="subcategory" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500">
          <option value="">-- Pehle Category select karo --</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Full Address / पूरा पता *</label>
        <textarea name="address" required rows="3"
          placeholder="Shop no, street, area..."
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500"></textarea>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Area / इलाका *</label>
        <select name="area" required
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500">
          <option value="">-- Select Area --</option>
          <option>Kotputli</option>
          <option>Behror</option>
        </select>
      </div>

      <div>
        <label class="block text-sm font-semibold mb-1">Description / विवरण</label>
        <textarea name="description" rows="3"
          placeholder="What do you sell or offer?"
          class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-orange-500"></textarea>
      </div>

      <div class="bg-orange-50 border border-orange-200 rounded-lg p-3 text-xs text-orange-800">
        ℹ️ <b>Admin approval के बाद ही आपकी दुकान public में दिखेगी।</b> Usually within 24 hours.
      </div>

      <button type="submit"
        class="w-full bg-orange-500 hover:bg-orange-600 text-white font-bold py-3 rounded-lg transition">
        Submit for Approval / जमा करें
      </button>

    </form>
  </main>

  <div class="h-20"></div>

  <script is:inline>
    const subcats = {
      Services: ['Mobile Repair', 'AC Repair', 'Vehicle Repair', 'Mechanic', 'Photography', 'Catering', 'Construction', 'DJ', 'Tailor', 'Beauty', 'Painting', 'Other'],
      Retail: ['Clothing', 'Footwear', 'Electronics', 'Mobile', 'Furniture', 'Grocery', 'Jewellery', 'Cosmetics', 'Stationery', 'Sports', 'Bags', 'Watches', 'Other'],
      Education: ['School', 'Coaching', 'Classes', 'Dance', 'Sports', 'Other'],
      Food: ['Restaurant', 'Dhaba', 'Fast Food', 'Bakery', 'Cake', 'Other'],
      Other: ['Other']
    };

    const catSelect = document.getElementById('category');
    const subSelect = document.getElementById('subcategory');

    catSelect.addEventListener('change', () => {
      const cat = catSelect.value;
      subSelect.innerHTML = '';
      if (!cat) {
        subSelect.innerHTML = '<option value="">-- Pehle Category select karo --</option>';
        return;
      }
      const placeholder = document.createElement('option');
      placeholder.value = '';
      placeholder.textContent = '-- Select Subcategory --';
      subSelect.appendChild(placeholder);
      subcats[cat].forEach(s => {
        const opt = document.createElement('option');
        opt.value = s;
        opt.textContent = s;
        subSelect.appendChild(opt);
      });
    });
 
    // Form submit
    const form = document.getElementById('businessForm');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector('button[type="submit"]');
      const originalText = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Submitting...';

            const fd = new FormData(form);

      try {
        const res = await fetch('https://offline-market-api.offlinemarket369.workers.dev/api/businesses', {
          method: 'POST',
          body: fd,
        });
        const json = await res.json();
        if (json.success) {
          alert('✅ ' + json.message);
          form.reset();
          document.getElementById('subcategory').innerHTML = '<option value="">-- Pehle Category select karo --</option>';
        } else {
          alert('❌ Error: ' + (json.error || 'Unknown error'));
        }
      } catch (err) {
        alert('❌ Network error: ' + err.message);
      } finally {
        btn.disabled = false;
        btn.textContent = originalText;
      }
    }); </script>

</body>
</html>